#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/format_staged.py
fi

if command -v python >/dev/null 2>&1; then
    exec python scripts/format_staged.py
fi

echo "Clarify pre-commit: Python 3 is required to run Ruff format." >&2
echo "Run npm run setup or install Python 3 before committing." >&2
exit 1
