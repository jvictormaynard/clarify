{
  "name": "clarify",
  "version": "0.15.0",
  "private": true,
  "scripts": {
    "build:settings": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-settings.ps1",
    "test": "python scripts/run_tests.py",
    "check": "python scripts/ci.py --task static",
    "setup-hooks": "git config core.hooksPath .githooks",
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "installer": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-installer.ps1",
    "setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup.ps1 -Dev",
    "deploy": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "ci": "python scripts/ci.py",
    "ci:plan": "python scripts/ci.py --plan",
    "ci:full": "python scripts/ci.py --full"
  }
}
