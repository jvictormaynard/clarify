# Copy to a secret store. Never commit a filled file.
DJANGO_SECRET_KEY=
DATABASE_URL=postgresql://clarify:CHANGE_ME@database:5432/clarify
ALLOWED_HOSTS=clarify-api.victormaynard.com
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=Clarify <login@victormaynard.com>
# Open only after delivery and abuse checks pass.
CLARIFY_SIGNUP_ENABLED=0
CLARIFY_DAILY_EMAIL_LIMIT=50
CLARIFY_FUNDED_ENABLED=0
GROQ_API_KEY=
CLARIFY_MONTHLY_AUDIO_MS=18000000
CLARIFY_MONTHLY_BUDGET_USD=0
CLARIFY_GLOBAL_CONCURRENCY=4
# Optional server-side OAuth apps. A missing ID/secret pair disables a provider.
# Use Web application registrations with callbacks documented in SOCIAL_AUTH.md.
CLARIFY_GOOGLE_CLIENT_ID=
CLARIFY_GOOGLE_CLIENT_SECRET=
CLARIFY_MICROSOFT_CLIENT_ID=
CLARIFY_MICROSOFT_CLIENT_SECRET=
CLARIFY_GITHUB_CLIENT_ID=
CLARIFY_GITHUB_CLIENT_SECRET=
