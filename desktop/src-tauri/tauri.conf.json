{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clarify Settings",
  "version": "0.1.0",
  "identifier": "app.clarify.settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Clarify — Configurações",
      "width": 1000, "height": 740, "minWidth": 640, "minHeight": 520,
      "backgroundColor": "#151515", "theme": "Dark", "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/clarify.ico"] }
}
