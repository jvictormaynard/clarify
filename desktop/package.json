{
  "name": "clarify-settings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.unit.json",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node scripts/test-unit.mjs",
    "test:browser": "node scripts/test-settings.mjs",
    "test:boot": "node scripts/test-settings.mjs --built",
    "check": "npm run build && tsc --noEmit -p tsconfig.unit.json && npm test && npm run test:boot",
    "desktop": "tauri dev",
    "bundle": "tauri build --no-bundle",
    "test:electron": "node --test scripts/electron.test.cjs",
    "build:electron": "node scripts/build.mjs --electron && node scripts/package-electron.mjs",
    "test:electron:smoke": "node scripts/run-electron-smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@tauri-apps/api": "^2.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.45.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "45.2.3",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.4",
      "minimatch": "11.0.5"
    }
  }
}
