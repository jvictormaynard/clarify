{
  "expo": {
    "name": "Clarify",
    "slug": "clarify-ios",
    "owner": "victormaynard",
    "version": "0.12.0",
    "scheme": "clarify",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.jvictormaynard.clarify",
      "buildNumber": "43",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "O Clarify usa o microfone para transcrever e reescrever o que você ditar.",
        "NSCameraUsageDescription": "O Clarify usa a câmera para ler o QR do seu computador.",
        "NSLocalNetworkUsageDescription": "O Clarify conecta este iPhone ao seu computador para processar ditados e textos.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "10.0.0.0/8": { "NSExceptionAllowsInsecureHTTPLoads": true, "NSExceptionMinimumTLSVersion": "TLSv1.2" },
            "172.16.0.0/12": { "NSExceptionAllowsInsecureHTTPLoads": true, "NSExceptionMinimumTLSVersion": "TLSv1.2" },
            "192.168.0.0/16": { "NSExceptionAllowsInsecureHTTPLoads": true, "NSExceptionMinimumTLSVersion": "TLSv1.2" }
          }
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "ClarifyAppGroup": "group.com.jvictormaynard.clarify",
        "ClarifyCloudURL": "https://clarify-api.victormaynard.com",
        "UIBackgroundModes": [
          "audio"
        ],
        "CFBundleLocalizations": [
          "pt",
          "en",
          "es"
        ],
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.jvictormaynard.clarify"
        ]
      }
    },
    "plugins": [
      "./plugins/with-clarify-keyboard.cjs",
      "./plugins/with-clarify-activity.cjs",
      "./plugins/with-computer-link-privacy.cjs",
      "./plugins/with-computer-relay.cjs",
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ClarifyKeyboard",
                  "bundleIdentifier": "com.jvictormaynard.clarify.keyboard",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.jvictormaynard.clarify"
                    ]
                  }
                },
                {
                  "targetName": "ClarifyActivity",
                  "bundleIdentifier": "com.jvictormaynard.clarify.activity",
                  "entitlements": {}
                }
              ]
            }
          }
        },
        "projectId": "6dc3404f-4bdb-4d12-8a3b-006355b408b3"
      }
    },
    "locales": {
      "pt": "./locales/pt.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json"
    }
  }
}
