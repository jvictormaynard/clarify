{
  "name": "clarify-mobile",
  "version": "0.11.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.31",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/mcp-tunnel": "0.3.1",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "8.0.1",
    "typescript": "~6.0.3",
    "zod": "4.6.7"
  },
  "overrides": {
    "query-string": "9.5.1",
    "@expo/cli": {
      "zod": "$zod"
    },
    "@expo/mcp-tunnel": "$@expo/mcp-tunnel"
  },
  "scripts": {
    "postinstall": "patch-package --error-on-fail",
    "start": "expo start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:native": "swift test --package-path modules/clarify-core",
    "check": "node scripts/check.cjs",
    "ios": "expo run:ios",
    "lint": "expo lint"
  },
  "private": true
}
