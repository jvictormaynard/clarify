{
  "name": "clarify-mobile",
  "version": "0.4.1",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:native": "swift test --package-path modules/clarify-core",
    "eas-build-post-install": "npm run test:native && node scripts/test-keyboard-ui.cjs",
    "check": "python3 scripts/sync-prompts.py --check && npm run typecheck && npm run lint && npm test && expo install --check",
    "ios": "expo run:ios",
    "lint": "expo lint"
  },
  "private": true
}
